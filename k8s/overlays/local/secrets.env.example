# Copy to secrets.env (git-ignored) and fill it in:
#
#     cp secrets.env.example secrets.env
#     ../../../infra/server/fill-secrets.sh secrets.env
#
# The same script the server uses: it generates every empty PASSWORD and
# SECRET with `openssl rand -hex 32`, sets the file to mode 600, and prints
# nothing.
#
# Why a file and not SOPS or sealed-secrets: this file never leaves the
# machine that created it, so there is nothing to encrypt FOR. The day these
# manifests are applied by something other than a person at a keyboard - a
# pipeline, Argo CD - the secret has to travel, and that is the day it needs
# to be encrypted at rest in git. Recorded in ADR-0022.

KP_POSTGRES_PASSWORD=
# The application takes a Redis URL, not a password. It is composed from
# this value inside the pod spec, so the secret lives in exactly one
# place. hex, so nothing in it has to be percent-encoded.
KP_REDIS_PASSWORD=

KP_OIDC_CLIENT_SECRET=

KP_KEYCLOAK_DB_PASSWORD=
KP_KEYCLOAK_ADMIN=admin
KP_KEYCLOAK_ADMIN_PASSWORD=

# Optional. Empty runs the product without generation: retrieval, citations
# and refusals all still work, and no question ever reaches a provider.
KP_GROQ_API_KEY=
