# Variables used by docker-compose.yml.
# Copy to .env and replace every value. .env is git-ignored and must never be
# committed. Generate strong local values with:
#
#   openssl rand -base64 24
#
# There is no default value anywhere on purpose: a missing variable stops
# Compose instead of silently starting an open system.

# --- Application database ---
KP_POSTGRES_USER=knowpilot
KP_POSTGRES_PASSWORD=replace-me
KP_POSTGRES_DB=knowpilot

# --- Keycloak database (same instance, separate database and user) ---
KP_KEYCLOAK_DB=keycloak
KP_KEYCLOAK_DB_USER=keycloak
KP_KEYCLOAK_DB_PASSWORD=replace-me

# --- Keycloak bootstrap admin (local development only) ---
KP_KEYCLOAK_ADMIN=admin
KP_KEYCLOAK_ADMIN_PASSWORD=replace-me

# --- Generation: hosted LLM (GroqCloud) ---
# Create the key at https://console.groq.com/keys, then paste it into .env
# (never here: .env.example is committed, .env is not).
# Leave KP_GROQ_API_KEY empty to run without generation: the chat endpoint
# then answers 503 instead of crashing at startup.
KP_GROQ_API_KEY=
#
# The model is one line of configuration because LanguageModel is a Protocol.
# The documentation lists llama-3.3-70b-versatile as a production model; the
# limits page of a real free account does not offer it. The account is the
# authority, the documentation is a description - always read the account.
#
# Free tier, measured on 2026-09-20: 30 RPM, 1K RPD, 8K TPM, 200K TPD.
# A question costs roughly 2300 tokens, so the binding limit is the daily token
# budget: about 85 questions a day for ALL users together. Per-user quotas are
# therefore a requirement of the chat endpoint, not a later refinement.
#
# groq/compound has nine times the throughput and is deliberately NOT used: it
# ships with web search and code execution, which would turn a poisoned
# document from "a wrong answer" into an exfiltration channel. Rate limits are
# survivable; an outbound channel is not.
KP_GROQ_MODEL=openai/gpt-oss-120b

# How many questions a day, per user and for the whole service. Policy, so
# it is configuration: one user on a laptop wants a different number from a
# shared instance. The per-user limit must not exceed the service one, or it
# could never be reached - the application refuses to start if it does.
#
# For local testing with a single account, raising the per-user limit to the
# service one makes the whole provider budget usable.
KP_DAILY_QUESTIONS_PER_USER=20
KP_DAILY_QUESTIONS_PER_SERVICE=80

# The calendar your users live in. Decides which day "today" is when an
# answer depends on a date (an amendment in force from the 1st).
KP_TIMEZONE=Europe/Paris

# Hybrid retrieval (ADR-0015): full-text search beside the embeddings, for
# phone numbers, references and names. false = vector-only.
KP_KEYWORD_SEARCH_ENABLED=true
# Share of the question words a passage must contain to be admitted on
# keywords alone. Measured: exact-value answers reach 0.7-1.0, noise <= 0.2.
KP_MIN_KEYWORD_COVERAGE=0.5

# LangSmith tracing (ADR-0014). A trace contains the retrieved passages - the
# private documents of users - so the API and the worker REFUSE TO START when
# LANGSMITH_TRACING is on, unless this says someone decided it on purpose.
# Leave it false and do not set LANGSMITH_TRACING.
KP_LANGSMITH_TRACING_ALLOWED=false
