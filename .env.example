# Variables used by docker-compose.yml.
# Copy to .env and replace every value. .env is git-ignored and must never be
# committed. Generate strong local values with:
#
#   openssl rand -base64 24
#
# There is no default value anywhere on purpose: a missing variable stops
# Compose instead of silently starting an open system.

# --- Application database ---
KP_POSTGRES_USER=knowpilot
KP_POSTGRES_PASSWORD=replace-me
KP_POSTGRES_DB=knowpilot

# --- Keycloak database (same instance, separate database and user) ---
KP_KEYCLOAK_DB=keycloak
KP_KEYCLOAK_DB_USER=keycloak
KP_KEYCLOAK_DB_PASSWORD=replace-me

# --- Keycloak bootstrap admin (local development only) ---
KP_KEYCLOAK_ADMIN=admin
KP_KEYCLOAK_ADMIN_PASSWORD=replace-me
