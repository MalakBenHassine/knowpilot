# node_modules is the reason this file exists. It is hundreds of megabytes,
# it contains binaries compiled for the host, and `npm ci` rebuilds it inside
# the image anyway. Sending it would make every build slower AND wrong.
node_modules/

# Build output: regenerated by the builder stage. A stale dist/ copied in
# would be the most confusing bug of the week - the image would serve code
# nobody can find in the repository.
dist/
dist-ssr/

# Vite reads .env at build time and BAKES the values into the bundle. A file
# that ends up inside a JavaScript file served to every visitor has no
# business being in a build context by accident.
.env
.env.*
!.env.example

coverage/
*.tsbuildinfo
.vite/
Dockerfile
.dockerignore
