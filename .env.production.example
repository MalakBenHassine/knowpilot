# Variables for docker-compose.prod.yml. Copy to .env.production ON THE SERVER,
# fill in every value, and keep it readable by its owner only:
#
#   cp .env.production.example .env.production && chmod 600 .env.production
#
# .env.production is git-ignored and must never leave the server. Every
# password below is generated, never typed:
#
#   openssl rand -hex 32
#
# Hex on purpose: the Redis password travels inside a URL, and hex has no
# character that a URL, a shell or YAML would interpret.

# --- The public address -------------------------------------------------------
# A DNS name pointing at the server. A free one works: <ip-with-dashes>.sslip.io
# resolves to the IP written in it, with no account to create (docs/deploy.md).
KP_DOMAIN=knowpilot.203-0-113-10.sslip.io
# Where Let's Encrypt writes before a certificate expires.
KP_ACME_EMAIL=you@example.org

# --- Images --------------------------------------------------------------------
# Built by the Release workflow and pulled from GitHub's registry, by commit.
# Leave both unset to build on the server instead (docker compose build).
# KP_IMAGE_REGISTRY=ghcr.io/malakbenhassine
# KP_IMAGE_TAG=<commit sha>

# --- Application database ----------------------------------------------------------
KP_POSTGRES_USER=knowpilot
KP_POSTGRES_PASSWORD=
KP_POSTGRES_DB=knowpilot

# --- Keycloak database (same instance, separate database and user) --------------
KP_KEYCLOAK_DB=keycloak
KP_KEYCLOAK_DB_USER=keycloak
KP_KEYCLOAK_DB_PASSWORD=

# --- Keycloak administrator ---------------------------------------------------------
# Created on the first start only. The admin console is NOT exposed to the
# internet (infra/caddy/Caddyfile): administration goes through the scripts in
# infra/keycloak/, run on the server.
KP_KEYCLOAK_ADMIN=admin
KP_KEYCLOAK_ADMIN_PASSWORD=

# Self-registration. Keep it false until email verification is configured:
# invite people with infra/keycloak/invite-user.sh instead.
KP_KEYCLOAK_REGISTRATION=false

# --- Grafana ------------------------------------------------------------------------
# The dashboard is published on 127.0.0.1 only, so reaching it means an SSH
# tunnel (docs/deploy.md). The password still matters: anyone who can open a
# shell on the server can open the dashboard.
KP_GRAFANA_ADMIN=admin
KP_GRAFANA_ADMIN_PASSWORD=

# --- The BFF's client secret ---------------------------------------------------------
# Generated here, like the others, and SET in Keycloak by setup-realm.sh - so
# nothing has to be copied from one place to another during the deployment.
KP_OIDC_CLIENT_SECRET=

# --- Redis -----------------------------------------------------------------------------
KP_REDIS_PASSWORD=

# --- Generation ---------------------------------------------------------------------------
# https://console.groq.com/keys. Empty runs the product without answers.
KP_GROQ_API_KEY=

# --- Optional tunables -----------------------------------------------------------------------
# Unset means the default of backend/app/core/config.py, which documents each
# one. Uncomment only to change a value.
# KP_DAILY_QUESTIONS_PER_USER=20
# KP_DAILY_QUESTIONS_PER_SERVICE=80
# KP_CHAT_REQUESTS_PER_MINUTE=10
# KP_UPLOAD_REQUESTS_PER_MINUTE=10
# KP_TIMEZONE=Europe/Paris
# KP_SUBJECT_CHECK_ENABLED=true
