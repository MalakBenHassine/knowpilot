# === Fins de ligne : LF par défaut pour tous les fichiers texte ===
* text=auto eol=lf

# === Exceptions : scripts Windows, qui exigent CRLF ===
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# === Fichiers binaires : aucune conversion, pas de diff texte ===
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.woff2 binary
